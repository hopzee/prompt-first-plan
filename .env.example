# FarmTrace configuration — copy to `.env` and fill in real values.
# `.env` is git-ignored. Never commit real credentials.
# On Streamlit Community Cloud, put the same keys in App settings → Secrets instead
# (see .streamlit/secrets.toml.example).

# REQUIRED. PostgreSQL connection string from your provider (Supabase, Neon, Render, Railway...).
# Supabase: Project → Connect → "Session pooler" URI. Append ?sslmode=require for hosted databases.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# REQUIRED for QR codes. The public address of the deployed Streamlit app (no trailing slash).
# Local development: http://localhost:8501
PUBLIC_APP_URL=https://your-app-name.streamlit.app

# development | production | test | demo
APP_ENV=development

# Time zone used for dates shown in the app and in reports.
APP_TIMEZONE=Africa/Lagos

# Allow available drivers to accept approved requests themselves (true/false).
ALLOW_DRIVER_SELF_ASSIGN=true

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Tests only: an EMPTY dedicated PostgreSQL database whose name contains "test".
# Every table in it is emptied during the test run.
# TEST_DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/farmtrace_test
