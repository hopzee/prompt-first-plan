# Streamlit secrets template.
# Locally: copy to .streamlit/secrets.toml (git-ignored).
# Streamlit Community Cloud: paste these lines into App settings → Secrets.
# Placeholder values only — replace them with your real settings.

DATABASE_URL = "postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"
PUBLIC_APP_URL = "https://your-app-name.streamlit.app"
APP_ENV = "production"
APP_TIMEZONE = "Africa/Lagos"
ALLOW_DRIVER_SELF_ASSIGN = "true"
LOG_LEVEL = "INFO"
